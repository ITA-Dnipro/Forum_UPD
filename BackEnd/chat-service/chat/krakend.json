{
    "version": 3,
    "timeout": "3000ms",
    "endpoints": [
      {
        "endpoint": "/api/conversations/",
        "method": "POST",
        "input_headers": [
          "Content-Type",
          "Content-Length"
        ],
        "output_encoding": "no-op",
        "backend": [
          {
            "host": ["http://chat-service:8000"],
            "url_pattern": "/api/conversations/",
            "method": "POST",
            "extra_config": {
              "github.com/devopsfaith/krakend/http": {
                "client_timeout": "2000ms"
              }
            }
          }
        ]
      }
    ]
  }
  