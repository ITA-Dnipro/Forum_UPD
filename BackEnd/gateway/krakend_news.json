{
  "version": 3,
  "name": "News Gateway",
  "endpoints": [

    {
      "endpoint": "/news",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "endpoint": "/check?requiredRole=Public",
          "method": "GET",
          "host": [
            "http://auth-service:8080"
          ],
          "header": "Authorization",
          "response_codes": [200],
          "cache": false
        }
      },
      "backend": [
        {
          "host": [
            "http://news-service:8000"
          ],
          "url_pattern": "/api/news"
        }
      ]
    },

    {
      "endpoint": "/news/{news_id}",
      "method": "GET",
      "extra_config": {
        "auth/validator": {
          "endpoint": "/check?requiredRole=Public",
          "method": "GET",
          "host": [
            "http://auth-service:8080"
          ],
          "header": "Authorization",
          "response_codes": [200],
          "cache": false
        }
      },
      "backend": [
        {
          "host": [
            "http://news-service:8000"
          ],
          "url_pattern": "/api/news/{news_id}"
        }
      ]
    },

    {
      "endpoint": "/news/{news_id}",
      "method": "DELETE",
      "extra_config": {
        "auth/validator": {
          "endpoint": "/check?requiredRole=Admin",
          "method": "GET",
          "host": [
            "http://auth-service:8080"
          ],
          "header": "Authorization",
          "response_codes": [200],
          "cache": false
        }
      },
      "backend": [
        {
          "host": [
            "http://news-service:8000"
          ],
          "url_pattern": "/api/news/{news_id}"
        }
      ]
    },

    {
      "endpoint": "/scrape",
      "method": "POST",
      "extra_config": {
        "auth/validator": {
          "endpoint": "/check?requiredRole=Admin",
          "method": "GET",
          "host": [
            "http://auth-service:8080"
          ],
          "header": "Authorization",
          "response_codes": [200],
          "cache": false
        }
      },
      "backend": [
        {
          "host": [
            "http://news-service:8000"
          ],
          "url_pattern": "/api/scrape"
        }
      ]
    }
  ]
}

